# --- LLM provider ---
# "mock" works out of the box with no API key (used for the demo/seed data).
# Set to "openai" or "anthropic" to use a real model.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gophish integration ---
# Leave GOPHISH_API_KEY empty to run the ai-service standalone (templates/analytics
# still work; pushing to Gophish and launching real campaigns will be skipped/logged).
GOPHISH_BASE_URL=https://localhost:3333
GOPHISH_API_KEY=
GOPHISH_VERIFY_SSL=false

# --- App ---
DATABASE_URL=sqlite:///./phishing_sim.db
APP_SECRET=change-me
